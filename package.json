{
  "name": "element-react-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/element-react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/element-react/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dark.css": "./dist/dark.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "docs:dev": "npm run dev",
    "docs:build": "node scripts/build-docs.mjs && vite build",
    "docs:preview": "vite preview --host 127.0.0.1",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/build-theme.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=reports/unit.json",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "eslint packages docs/src docs/examples tests --max-warnings 0",
    "format": "prettier --write packages docs/src docs/examples tests scripts/*.mjs *.ts *.json",
    "format:check": "prettier --check packages docs/src docs/examples tests scripts/*.mjs *.ts *.json",
    "audit:tasks": "node scripts/build-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:tasks && npm run build && npm run docs:build",
    "pretest": "node scripts/prepare-test.mjs",
    "predev": "node scripts/build-docs.mjs",
    "pretest:browser": "npm run docs:build"
  },
  "dependencies": {
    "@ctrl/tinycolor": "4.2.2",
    "@floating-ui/dom": "1.8.0",
    "async-validator": "4.2.5",
    "dayjs": "1.11.23",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.107.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
